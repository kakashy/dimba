# Drizzle — Neon Postgres connection string (use -pooler endpoint for runtime)
DATABASE_URL="postgresql://user:password@ep-example.aws.neon.tech/dimba?sslmode=require"

# Web push (generate ONCE with: npx web-push generate-vapid-keys)
# Public key goes here (client-exposed); private key ONLY in Vercel/GCP secrets.
PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:you@example.com"

# Internal sync (scraper → app). Set the same value in Vercel and the Cloud Run job.
INTERNAL_SYNC_SECRET="change-me-at-least-8-chars"
